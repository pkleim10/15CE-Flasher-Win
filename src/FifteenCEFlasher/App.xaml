<Application x:Class="FifteenCEFlasher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="PaperBrush" Color="#F7F6F3"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7280"/>
    </Application.Resources>
</Application>
