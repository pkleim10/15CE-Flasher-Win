<Window x:Class="FifteenCEFlasher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="15CE Flasher"
        Width="960" Height="720"
        MinWidth="800" MinHeight="600"
        Background="{StaticResource PaperBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="15CE Flasher" FontSize="28" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
            <TextBlock x:Name="SubtitleText" Text="Mach II Labs · Windows" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Content -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="#E5E7EB" BorderThickness="1" Padding="24">
            <ContentControl x:Name="MainContent"/>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock x:Name="DetailText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <ProgressBar x:Name="ProgressBar" Grid.Column="1" Width="160" Height="8" VerticalAlignment="Center" Minimum="0" Maximum="1"/>
            </Grid>
        </Border>
    </Grid>
</Window>
